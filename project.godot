; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aura"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
; Android back button must NOT quit the app. Godot's default is true, which killed a
; run mid-play with no confirmation and no pause -- users read that as a crash. With
; this false the press arrives as NOTIFICATION_WM_GO_BACK_REQUEST, which GameManager
; turns into a pause. See scripts/game/game_manager.gd.
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Services="*res://scripts/autoload/services.gd"

[display]

; PINNED, and this is an art-authoring reference as much as a window size. It was unset,
; so the engine's own 1152x648 default applied -- meaning sprite pixel density had no
; declared reference point and every art decision was being made against a number written
; down nowhere. Pinning the value the project was already running at changes nothing
; observable: visible world = base / Camera2D.zoom = 1152/0.8333 x 648/0.8333 = 1382x778
; world px, exactly as before. No world constant moves (GROUND_Y, ICE_BAND_DEPTH,
; FILL_GRADIENT_DEPTH, CHASM_LEAD_IN_LENGTH are all world px), and every base_y_fraction
; in main.tscn keeps its meaning.
;
; BASE SIZE AND CAMERA ZOOM ARE ONE DECISION -- only their RATIO is gameplay. Changing
; either alone changes the field of view, i.e. how much warning the player gets on an
; auto-runner. Never touch one without the other.
;
; Listed in these two keys' own right order, matching what the editor writes, so a stray
; editor run produces no diff here. See docs/development/visuals.md, "Base viewport size".
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
; NOT "keep". With expand, scale = min(window.x/base.x, window.y/base.y) and the viewport
; becomes window/scale -- so the base is a MINIMUM in both axes and a device never sees
; less, only more in one direction. A 20:9 phone gets 1440x648 (+25% forward visibility);
; a 4:3 tablet gets 1152x864 (extra sky and ground, not extra warning distance). "keep"
; would equalise that at the cost of letterbox bars on every modern phone, which is the
; wrong trade for a game whose whole appeal is the landscape. Equalising it properly means
; an aspect-compensated Camera2D.zoom -- a real open option, but it changes what players
; see and needs camera_shake_probe re-run plus a playtest, so it is deliberately not
; bundled with this.
window/stretch/aspect="expand"
; Side-scroller: portrait is never correct. Was unset, which left it to the Android
; manifest default.
window/handheld/orientation="landscape"

[physics]

3d/physics_engine="Jolt Physics"
; PINNED, not left to the engine default. Several terrain constants derive from
; 1.0/physics_ticks_per_second, so this value is level geometry -- CLAUDE.md has called
; it load-bearing the whole time while it was the one number not written down anywhere
; the engine actually reads. 60 is the value everything to date was measured at.
common/physics_ticks_per_second=60
; Also pinned: the docs state interpolation is OFF and every measurement assumes it.
common/physics_interpolation=false

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
